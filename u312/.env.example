# UNICAR - exemplo de configuracao
#
# Como usar: copie este arquivo com o nome  .env  (na mesma pasta do server.js) e ajuste.
# O arquivo .env NAO entra no git e NAO e obrigatorio: sem ele, o sistema usa os padroes
# que estao entre parenteses em cada linha abaixo.

# Porta do sistema (padrao 3000). No PC da loja usa-se 3001.
PORT=3001

# Endereco em que o sistema escuta (padrao 0.0.0.0 = todos os aparelhos da rede local).
# Para aceitar somente o proprio computador, use 127.0.0.1.
HOST=0.0.0.0

# Arquivo de dados e pastas (pode ser caminho relativo ou completo)
ARQUIVO_DADOS=data.json
PASTA_BACKUPS=backups
PASTA_LOGS=logs

# Quanto sai no log: debug | info | aviso | erro | silencio  (padrao info)
NIVEL_LOG=info

# Backup automatico: de quanto em quanto tempo e quantos arquivos guardar
# (padrao 21600000 ms = 6 horas e 60 arquivos)
INTERVALO_BACKUP_MS=21600000
MAX_BACKUP_ARQUIVOS=60

# Limite de historico guardado dentro do arquivo de dados
# (padrao: movimentos 500, auditoria 3000 — o mais antigo e descartado)
LIMITE_MOVIMENTOS=500
LIMITE_AUDITORIA=3000

# Quantos dias de log guardar (padrao 14)
DIAS_DE_LOG=14

# Nome do ambiente. Nao muda o funcionamento; aparece em /api/diagnostico.
NODE_ENV=producao
